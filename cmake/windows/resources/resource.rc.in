#define _AFXDLL
#include <winresrc.h>

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @PLUGIN_VERSION_MAJOR@,@PLUGIN_VERSION_MINOR@,@PLUGIN_VERSION_PATCH@,0
    PRODUCTVERSION @PLUGIN_VERSION_MAJOR@,@PLUGIN_VERSION_MINOR@,@PLUGIN_VERSION_PATCH@,0
    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0
    FILEOS 0x40000L
    FILETYPE 0x2L
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "QTChat"
            VALUE "FileDescription", "QTChat OBS Plugin"
            VALUE "FileVersion", "@PLUGIN_VERSION@"
            VALUE "InternalName", "QTChat"
            VALUE "LegalCopyright", "Copyright (C) 2024"
            VALUE "OriginalFilename", "QTChat.dll"
            VALUE "ProductName", "QTChat"
            VALUE "ProductVersion", "@PLUGIN_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
